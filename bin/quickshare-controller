#!/usr/bin/env bash
set -euo pipefail

CACHE_BIN="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-quickshare/bin/quickshare-controller"

if [[ -x "${CACHE_BIN}" ]]; then
  exec "${CACHE_BIN}" "$@"
fi

if command -v quickshare-controller &>/dev/null; then
  exec quickshare-controller "$@"
fi

echo "quickshare-controller binary not found in ${CACHE_BIN} or PATH." >&2
exit 1
