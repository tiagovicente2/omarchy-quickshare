#!/usr/bin/env bash

set -euo pipefail

fail() {
  printf 'Quick Share controller: %s\n' "$*" >&2
  exit 1
}

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
metadata="$repo_root/controller-release.env"

[[ -f "$metadata" && ! -L "$metadata" ]] || fail "missing trusted release metadata"

# shellcheck disable=SC1090
source "$metadata"

[[ "${QUICKSHARE_CONTROLLER_TAG:-}" =~ ^controller-v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid release tag"
[[ "${QUICKSHARE_CONTROLLER_ASSET:-}" == "quickshare-controller-x86_64-unknown-linux-gnu" ]] || fail "invalid release asset"
[[ "${QUICKSHARE_CONTROLLER_SIZE:-}" =~ ^[1-9][0-9]{0,8}$ ]] || fail "invalid release size"
((QUICKSHARE_CONTROLLER_SIZE <= 33554432)) || fail "release size exceeds launcher limit"
[[ "${QUICKSHARE_CONTROLLER_SHA256:-}" =~ ^[0-9a-f]{64}$ ]] || fail "invalid release checksum"
[[ "$(uname -m)" == "x86_64" ]] || fail "the published controller supports x86-64 Linux only"

command -v curl >/dev/null 2>&1 || fail "curl is required to install the controller"
command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is required to verify the controller"
command -v stat >/dev/null 2>&1 || fail "stat is required to verify the controller size"

cache_home="${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}"
cache_dir="${QUICKSHARE_CONTROLLER_CACHE_DIR:-$cache_home/omarchy-quickshare/controllers/$QUICKSHARE_CONTROLLER_TAG}"
controller="$cache_dir/$QUICKSHARE_CONTROLLER_ASSET"
url="https://github.com/tiagovicente2/omarchy-quickshare/releases/download/$QUICKSHARE_CONTROLLER_TAG/$QUICKSHARE_CONTROLLER_ASSET"

verify_controller() {
  local candidate="$1"
  local digest
  local size

  [[ -f "$candidate" && ! -L "$candidate" ]] || return 1
  size="$(stat --format='%s' -- "$candidate")" || return 1
  [[ "$size" == "$QUICKSHARE_CONTROLLER_SIZE" ]] || return 1
  digest="$(sha256sum -- "$candidate")" || return 1
  [[ "${digest%% *}" == "$QUICKSHARE_CONTROLLER_SHA256" ]]
}

install -d -m 0700 -- "$cache_dir"

if ! verify_controller "$controller"; then
  temporary="$(mktemp "$cache_dir/.controller.XXXXXX")"
  trap 'rm -f -- "${temporary:-}"' EXIT

  if ! curl \
    --disable \
    --fail \
    --location \
    --max-filesize "$QUICKSHARE_CONTROLLER_SIZE" \
    --proto '=https' \
    --tlsv1.2 \
    --retry 3 \
    --connect-timeout 15 \
    --max-time 300 \
    --silent \
    --show-error \
    "$url" > "$temporary"; then
    fail "controller download failed or exceeded the reviewed size"
  fi

  verify_controller "$temporary" || fail "downloaded controller size or checksum does not match the reviewed release"
  chmod 0700 -- "$temporary"
  mv -fT -- "$temporary" "$controller"
  trap - EXIT
fi

verify_controller "$controller" || fail "cached controller checksum does not match the reviewed release"
chmod 0700 -- "$controller"
exec "$controller" "$@"
